# Agent Blue Accounting - Environment Configuration
# Development-only values. Do NOT commit real credentials.
# Copy this file to .env and adjust as needed.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentblue
DB_PASSWORD=agentblue
DB_NAME=agentblue_dev

# JWT Security (required for staging/production-shadow/production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Production-Safety Flags (cannot be enabled in production-shadow/production)
ACCOUNTING_EXECUTION_MODE=shadow
AUTOMATIC_APPROVAL_ENABLED=false
AUTONOMOUS_WRITEBACK_ENABLED=false
ML_PROMOTION_ENABLED=false

# Worker
WORKER_ENABLED=false
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_LEASE_DURATION_SECONDS=300
WORKER_MAX_BATCH_SIZE=50

# Rate Limiting
RATE_LIMIT_ENABLED=true

# QuickBooks (optional)
# QB_CLIENT_ID=
# QB_CLIENT_SECRET=
# QB_REDIRECT_URI=
# QB_ENVIRONMENT=sandbox
