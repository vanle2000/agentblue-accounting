# Agent Blue Accounting - Environment Configuration
# Development-only values. Do NOT commit real credentials.
# Copy this file to .env and adjust as needed.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (development-only credentials)
DB_HOST=localhost
DB_PORT=5433
DB_USER=agentblue
DB_PASSWORD=agentblue
DB_NAME=agentblue_dev

# QuickBooks Online OAuth (optional — required for QuickBooks integration)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting

# Security / Authentication (Stage 9)
# JWT signing key — REQUIRED in production (minimum 32 characters)
JWT_SECRET_KEY=
# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256
# JWT issuer claim (default: agentblue-accounting)
JWT_ISSUER=agentblue-accounting
# JWT audience claim (default: agentblue-api)
JWT_AUDIENCE=agentblue-api
# Access token lifetime in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Allowed clock skew in seconds (default: 30)
JWT_ALLOWED_CLOCK_SKEW_SECONDS=30
# Development-only: bypass authentication (NEVER enable in production)
AUTH_BYPASS_ENABLED=false
